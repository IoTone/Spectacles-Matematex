  InputLines:
    - '// @input Asset.Material material {"hint":"Unlit material — the same one assigned to MatematexBookOfMath.lineMaterial."}'
    - '// @input SceneObject templateText {"hint":"Text3D template to clone glyphs from — the same one the book uses."}'
    - '// @input float coverHalfWidth = "20" {"hint":"Half-width of the cover slab."}'
    - '// @input float coverHalfHeight = "28" {"hint":"Half-height of the cover slab. Portrait, like the pages inside."}'
    - '// @input float coverHalfDepth = "3" {"hint":"Half-depth — the thickness of the closed book."}'
    - '// @input float planeZ = "39" {"hint":"Local Z this object moves itself to on awake. Must match MatematexBookOfMath.containerWorldZ."}'
    - '// @input vec4 coverColor = "{0.12, 0.16, 0.30, 0.22}" {"hint":"Cover fill RGBA. Low alpha on purpose: enough to tint, not enough to block the room."}'
    - '// @input vec4 edgeColor = "{0.65, 0.78, 1.00, 0.85}" {"hint":"Edge rule RGBA. On an additive display the EDGES are what make a slab read as a solid."}'
    - '// @input vec4 titleAccentColor = "{1.00, 0.78, 0.35, 1.00}" {"hint":"Colour of the XR superscript. Keep it the same as MatematexBookOfMath.titleAccentColor — cover and title page are the same title and should look it."}'
    - '// @input int columns = "9" {"hint":"Columns of falling symbols across the cover face. columns x perColumn x facesPerDrop KaTeX layouts run once, when the cover is first shown — the build time is printed."}'
    - '// @input int perColumn = "4" {"hint":"Symbols per column. columns x perColumn is the number of drops."}'
    - '// @input float fallSpeed = "9.0" {"hint":"Base fall speed in world units per second. Each column varies 0.6-1.4x so they never phase-lock."}'
    - "// @input float rainScale = \"0.5\" {\"hint\":\"Glyph scale for the rain, relative to the book's own text.\"}"
    - '// @input int facesPerDrop = "2" {"hint":"Pre-laid-out fragments per drop. One is enabled at a time and they cycle on recycle, so this is how much variety a column has before it repeats. Every one costs a KaTeX layout at build."}'
    - '// @input bool rainEnabled = "true"'
