  InputLines:
    - '// @input Asset.Material material {"hint":"Unlit material — the same one assigned to MatematexBookOfMath.lineMaterial."}'
    - '// @input float halfWidth = "26" {"hint":"Half-width of the sheet in world units. 26 with halfHeight 37 is portrait 1:1.41."}'
    - '// @input float halfHeight = "37" {"hint":"Half-height of the sheet. Larger than the ±27 vertical FOV budget on purpose — see the header."}'
    - '// @input float pitch = "4" {"hint":"Grid pitch in world units. 4 gives ~13 columns on a 26-half-width page."}'
