    - '// @input float pageZ = "-0.6" {"hint":"Local Z of the paper. Grid sits 0.05 in front, rule 0.10, so content at z 0 stays on top."}'
    - "// @input float planeZ = \"39\" {\"hint\":\"Local Z this object moves itself to on awake, so the page lands on the same plane as the book's content. Must match MatematexBookOfMath.containerWorldZ.\"}"
