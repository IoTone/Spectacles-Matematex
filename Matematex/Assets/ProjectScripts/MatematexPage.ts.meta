    - '// @input float majorWeight = "0.22"'
    - '// @input float borderWeight = "0.35"'
    - '// @input vec4 paperColor = "{0.09, 0.10, 0.13, 0.55}" {"hint":"Paper fill RGBA. Alpha 0 draws no paper at all — that is the current transparent look, kept one input away for comparison."}'
